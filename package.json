{
  "name": "overblaze",
  "productName": "OverBlaze",
  "version": "1.0.0",
  "description": "OverBlaze - hologram arena shooter",
  "main": "main.js",
  "homepage": "https://overblazeplay.web.app",
  "author": {
    "name": "OverBlaze",
    "email": "360581990+alekseybatalov2016-cmyk@users.noreply.github.com"
  },
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.overblaze.app",
    "productName": "OverBlaze",
    "files": [
      "main.js",
      "offline.html",
      "build/icon.png"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "OverBlaze-Setup.exe"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Game",
      "maintainer": "OverBlaze <360581990+alekseybatalov2016-cmyk@users.noreply.github.com>",
      "synopsis": "Hologram arena shooter"
    },
    "deb": {
      "artifactName": "OverBlaze-Ubuntu.deb"
    },
    "appImage": {
      "artifactName": "OverBlaze-Linux.AppImage"
    }
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "electron@45.5.0": true,
    "electron-winstaller": false
  }
}
